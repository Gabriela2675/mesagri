{
  "name": "@mesagri/web",
  "version": "1.0.0",
  "private": true,
  "description": "App de los cuatro perfiles, panel web y escenario de la demo (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node gen-icons.mjs",
    "e2e": "playwright test",
    "build:autonoma": "vite build --mode autonoma",
    "e2e:autonoma": "npx --yes http-server@14.1.1 dist-app -p 8090 -s & sleep 2; MESAGRI_WEB=http://localhost:8090 MESAGRI_LOCAL=1 playwright test; kill %1"
  },
  "dependencies": {
    "@mesagri/shared": "1.0.0",
    "@vladmandic/face-api": "1.7.15",
    "jsqr": "^1.4.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "socket.io-client": "4.8.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@playwright/test": "1.56.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "lucide": "1.48.0",
    "vite": "7.3.7"
  },
  "license": "UNLICENSED"
}
