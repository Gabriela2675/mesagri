{
  "name": "@mesagri/api",
  "version": "1.0.0",
  "private": true,
  "description": "API de Mesagri (14.1): Node.js LTS, TypeScript y NestJS, con MySQL 8.4. Aplica las reglas de @mesagri/shared y guarda cada acción en una transacción.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/build-id.txt', String(Date.now()))\"",
    "start": "node dist/main.js",
    "dev": "npm run build && node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@mesagri/shared": "1.0.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.8",
    "hash-wasm": "4.12.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1"
  },
  "license": "UNLICENSED"
}
